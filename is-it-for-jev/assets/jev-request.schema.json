{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "is-it-for-jev/jev-request.schema.json",
  "title": "TypeSafe Jev request (POST /v1/systemone)",
  "description": "Request body for POST https://api.typesafe.ai/v1/systemone. Transcribed from docs.typesafe.ai/api (checked September 2026). Re-check the live reference before relying on limits.",
  "type": "object",
  "required": ["state", "model", "questions"],
  "additionalProperties": false,
  "properties": {
    "state": {
      "description": "The content to evaluate: plain text, or an object/array for records, chat logs, or application state.",
      "type": ["string", "object", "array"]
    },
    "model": {
      "description": "Model id. 'jev-latest' is an alias that can move; pin a version such as 'jev-1.13.0' in production and record the resolved model from the response.",
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "description": "Map of question id to question. The id is yours; it is not sent to the model, so each question's instructions must stand on their own.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "entry": {
      "description": "Text or structured content.",
      "type": ["string", "object", "array"]
    },
    "question": {
      "oneOf": [
        { "$ref": "#/$defs/noul" },
        { "$ref": "#/$defs/choice" },
        { "$ref": "#/$defs/score" }
      ]
    },
    "noul": {
      "type": "object",
      "required": ["type", "instructions"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "noul" },
        "instructions": { "$ref": "#/$defs/entry" },
        "criteria": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "true": { "$ref": "#/$defs/entry" },
            "false": { "$ref": "#/$defs/entry" }
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "required": ["type", "instructions", "criteria"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "choice" },
        "instructions": { "$ref": "#/$defs/entry" },
        "criteria": {
          "description": "Option id mapped to its description, or null. 255 options maximum. The model always returns one of these, so include an explicit 'none fits' option when that outcome is possible.",
          "type": "object",
          "minProperties": 2,
          "maxProperties": 255,
          "additionalProperties": {
            "anyOf": [ { "$ref": "#/$defs/entry" }, { "type": "null" } ]
          }
        }
      }
    },
    "score": {
      "type": "object",
      "required": ["type", "instructions", "criteria"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "score" },
        "instructions": { "$ref": "#/$defs/entry" },
        "criteria": {
          "description": "Ordered level descriptions, lowest first. 2 to 10 levels.",
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    }
  }
}
